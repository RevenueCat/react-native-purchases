diff --git a/RevenueCatUI/Checkpoints/ErrorPresentationContext.swift b/RevenueCatUI/Checkpoints/ErrorPresentationContext.swift
new file mode 100644
index 0000000..a6974f2
--- /dev/null
+++ b/RevenueCatUI/Checkpoints/ErrorPresentationContext.swift
@@ -0,0 +1,34 @@
+// Prototype-only SPI for a hybrid error UI host. Not a consumer-facing API.
+#if canImport(UIKit) && !os(tvOS) && !os(watchOS)
+import UIKit
+
+@_spi(Internal)
+@MainActor
+@available(iOS 15.0, macOS 12.0, tvOS 15.0, watchOS 8.0, *)
+public final class ErrorPresentationContext {
+    public private(set) weak var viewController: UIViewController?
+    public private(set) var isValid = true
+    private var invalidationHandler: (() -> Void)?
+
+    public var onInvalidated: (() -> Void)? {
+        get { self.invalidationHandler }
+        set {
+            if self.isValid { self.invalidationHandler = newValue }
+            else { newValue?() }
+        }
+    }
+
+    init(viewController: UIViewController?) {
+        self.viewController = viewController
+    }
+
+    func invalidate() {
+        guard self.isValid else { return }
+        self.isValid = false
+        self.viewController = nil
+        let handler = self.invalidationHandler
+        self.invalidationHandler = nil
+        handler?()
+    }
+}
+#endif
