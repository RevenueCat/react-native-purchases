{
  "name": "react-native-purchases-admob",
  "title": "React Native Purchases AdMob",
  "version": "10.15.0",
  "description": "RevenueCat adapter for react-native-google-mobile-ads: automatic ad tracking and rewarded-ad reward verification.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "tslint": "tslint -c tslint.json 'src/*.ts'",
    "prepare": "bob build",
    "apitest": "echo \"Running react-native-purchases-admob API type checks\" && tsc --project apitesters/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revenuecat/react-native-purchases.git",
    "baseUrl": "https://github.com/revenuecat/react-native-purchases"
  },
  "keywords": [
    "react-native",
    "admob",
    "ads",
    "revenuecat",
    "iOS",
    "Android"
  ],
  "author": "RevenueCat, Inc.",
  "license": "MIT",
  "readmeFilename": "README.md",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.44",
    "@types/react-dom": "~18.2.0",
    "@types/react-test-renderer": "^18.0.7",
    "jest": "^29.7.0",
    "jest-react-native": "^18.0.0",
    "prettier": "^2.0.5",
    "react": "18.2.0",
    "react-native": "0.78.0",
    "react-native-builder-bob": "^0.20.0",
    "react-native-google-mobile-ads": "^17.0.0",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.1.2",
    "tslint": "^5.20.0",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.2.2"
  },
  "resolutions": {
    "@types/react": "^18.2.44",
    "@types/react-dom": "18.2.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">= 0.76.0",
    "react-native-google-mobile-ads": ">= 17.0.0 < 18.0.0",
    "react-native-purchases": "10.15.0"
  },
  "packageManager": "yarn@3.6.1+sha512.de524adec81a6c3d7a26d936d439d2832e351cdfc5728f9d91f3fc85dd20b04391c038e9b4ecab11cae2b0dd9f0d55fd355af766bc5c1a7f8d25d96bb2a0b2ca",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "testRegex": "(/__tests__/.*|\\.(test|spec))\\.(ts|tsx|js)$",
    "testPathIgnorePatterns": [
      "\\.snap$",
      "<rootDir>/node_modules/"
    ],
    "cacheDirectory": ".jest/cache",
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    },
    "moduleNameMapper": {
      "^react-native-purchases$": "<rootDir>/../dist/index"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
