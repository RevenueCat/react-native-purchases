# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'PurchaseTester' do
  # Local development pods contain symlinks back to this repository. Limit CLI discovery
  # to iOS so Android descriptor discovery does not recursively scan those symlinks.
  config = if ENV['RC_CHECKPOINT_LOCAL_DEPS'] == '1'
    use_native_modules!(['node', '-e',
      "process.argv=['', '', 'config', '--platform', 'ios'];require('@react-native-community/cli').run()"])
  else
    use_native_modules!
  end

  # Opt in to the isolated checkpoint SDK sources for this workspace only.
  if ENV['RC_CHECKPOINT_LOCAL_DEPS'] == '1'
    checkpoint_deps = File.expand_path('../../../.context/deps', __dir__)
    pod 'RevenueCat', :path => File.join(checkpoint_deps, 'purchases-ios')
    pod 'RevenueCatUI', :path => File.join(checkpoint_deps, 'purchases-ios')
    pod 'PurchasesHybridCommon', :path => File.join(checkpoint_deps, 'purchases-hybrid-common')
    pod 'PurchasesHybridCommonUI', :path => File.join(checkpoint_deps, 'purchases-hybrid-common')
  end

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # See https://github.com/facebook/react-native/issues/37748
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)', '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION']
      end
    end

    # react_native_post_install only bumps each pod's main target, so resource bundle targets
    # (e.g. RevenueCat-RevenueCat) keep the podspec's iOS 13.0, which Xcode 27 rejects.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < min_ios_version_supported.to_f
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
